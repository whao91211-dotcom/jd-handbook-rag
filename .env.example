# ============================================================
# OpenAI 兼容 API 配置模板 —— 复制本文件为 .env 后填写
#   cp .env.example .env        (Windows: copy .env.example .env)
# ============================================================

# 必填：你的 API Key（任选一家 OpenAI 兼容服务）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 必填：接口地址 base_url（OpenAI 兼容 /v1 风格）
#  DeepSeek   https://api.deepseek.com
#  通义千问   https://dashscope.aliyuncs.com/compatible-mode/v1
#  智谱       https://open.bigmodel.cn/api/paas/v4
#  OpenAI     https://api.openai.com/v1
OPENAI_BASE_URL=https://api.deepseek.com

# 选填：模型名（默认 deepseek-chat，随上面的服务商调整）
#  DeepSeek: deepseek-chat | 通义: qwen-plus / qwen-turbo
#  智谱: glm-4-flash / glm-4-air | OpenAI: gpt-4o-mini
RAG_LLM_MODEL=deepseek-chat

# 选填：检索送入 LLM 的块数上限（默认 8）
# RAG_TOP_K=8
